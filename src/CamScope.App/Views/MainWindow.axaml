<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CamScope.App.ViewModels"
        xmlns:views="using:CamScope.App.Views"
        x:Class="CamScope.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CamScope — Surveillance &amp; Discovery Platform"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">

  <Grid RowDefinitions="Auto, Auto, *">

    <!-- Top Toolbar -->
    <Border Grid.Row="0" Background="{StaticResource SurfaceBackground}"
            BorderBrush="{StaticResource SubtleBorder}" BorderThickness="0,0,0,1"
            Padding="16,10">
      <Grid ColumnDefinitions="Auto, *, Auto">

        <!-- App Brand -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource CyanAccent}">
            <TextBlock Text="CS" Foreground="#090D16" FontWeight="Bold" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CamScope" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Discover. Connect. Monitor." FontSize="10" Foreground="{StaticResource TextMuted}"/>
          </StackPanel>
        </StackPanel>

        <!-- Center Status Badges -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" VerticalAlignment="Center">
          <!-- Interface Badge -->
          <Border Classes="badgeCyan" ToolTip.Tip="Selected Local Interface">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="NET:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
              <TextBlock Text="{Binding SelectedInterfaceText}" FontSize="11" Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>
          </Border>

          <!-- Discovery Status Badge -->
          <Border Classes="badgeViolet">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="DISCOVERY:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource VioletAccent}"/>
              <TextBlock Text="{Binding DiscoveryStateText}" FontSize="11" Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>
          </Border>

          <!-- Demo Mode Badge -->
          <Border Classes="badgeWarning" IsVisible="{Binding IsDemoModeEnabled}">
            <TextBlock Text="DEMO MODE ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AmberWarning}"/>
          </Border>
        </StackPanel>

        <!-- Right Controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- Demo Mode Toggle -->
          <CheckBox Content="Demo Mode" IsChecked="{Binding IsDemoModeEnabled}"
                    FontSize="12" Foreground="{StaticResource TextSecondary}"/>

          <!-- Theme Toggle Button -->
          <ToggleButton Content="Dark / Light" IsChecked="{Binding IsDarkTheme}"
                        Classes="secondary" FontSize="11" Padding="8,4"/>

          <!-- Creator Profile Button -->
          <Button Command="{Binding OpenProfileModalCommand}"
                  Classes="secondary" FontSize="11" Padding="6,4" ToolTip.Tip="About Creator: Shatrughna Ambhore">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Width="18" Height="18" CornerRadius="9" ClipToBounds="True">
                <Image Source="avares://CamScope.App/Assets/images/shatrughna.jpg" Stretch="UniformToFill"/>
              </Border>
              <TextBlock Text="Creator" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

      </Grid>
    </Border>

    <!-- Notification / Warning Banner -->
    <Border Grid.Row="1" Background="#1E293B" BorderBrush="{StaticResource AmberWarning}"
            BorderThickness="0,0,0,1" Padding="14,8"
            IsVisible="{Binding HasNotification}">
      <Grid ColumnDefinitions="*, Auto">
        <TextBlock Grid.Column="0" Text="{Binding NotificationText}"
                   Foreground="{StaticResource AmberWarning}" FontSize="12" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissNotificationCommand}"
                Classes="secondary" Padding="8,2" FontSize="11"/>
      </Grid>
    </Border>

    <!-- Main Workspace -->
    <Grid Grid.Row="2" ColumnDefinitions="220, *">

      <!-- Persistent Sidebar Navigation -->
      <Border Grid.Column="0" Background="{StaticResource SurfaceBackground}"
              BorderBrush="{StaticResource SubtleBorder}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*, Auto">

          <!-- Nav Items List -->
          <ListBox Grid.Row="0" SelectedIndex="{Binding SelectedNavigationIndex}"
                   Background="Transparent" BorderThickness="0" Margin="4,8">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBoxItem Classes="navItem">
              <TextBlock Text="Overview" FontSize="13"/>
            </ListBoxItem>
            <ListBoxItem Classes="navItem">
              <TextBlock Text="Discover Devices" FontSize="13"/>
            </ListBoxItem>
            <ListBoxItem Classes="navItem">
              <TextBlock Text="Camera Inventory" FontSize="13"/>
            </ListBoxItem>
            <ListBoxItem Classes="navItem">
              <TextBlock Text="Live Monitoring" FontSize="13"/>
            </ListBoxItem>
            <ListBoxItem Classes="navItem">
              <TextBlock Text="Recordings" FontSize="13"/>
            </ListBoxItem>
            <ListBoxItem Classes="navItem">
              <TextBlock Text="Network Explorer" FontSize="13"/>
            </ListBoxItem>
            <ListBoxItem Classes="navItem">
              <TextBlock Text="Wi-Fi Security" FontSize="13"/>
            </ListBoxItem>
            <ListBoxItem Classes="navItem">
              <TextBlock Text="Device Groups" FontSize="13"/>
            </ListBoxItem>
            <ListBoxItem Classes="navItem">
              <TextBlock Text="Health &amp; Diagnostics" FontSize="13"/>
            </ListBoxItem>
            <ListBoxItem Classes="navItem">
              <TextBlock Text="Activity Audit" FontSize="13"/>
            </ListBoxItem>
            <ListBoxItem Classes="navItem">
              <TextBlock Text="Settings" FontSize="13"/>
            </ListBoxItem>
          </ListBox>

          <!-- Sidebar Footer with Created By Profile Button -->
          <Border Grid.Row="1" Padding="10" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
              <!-- Created By Card Button -->
              <Button Command="{Binding OpenProfileModalCommand}"
                      Background="#131F33" BorderBrush="{StaticResource CyanAccent}" BorderThickness="1"
                      CornerRadius="8" Padding="8,6" HorizontalAlignment="Stretch" Cursor="Hand">
                <Grid ColumnDefinitions="Auto, *">
                  <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" ClipToBounds="True" Margin="0,0,8,0"
                          BorderBrush="{StaticResource CyanAccent}" BorderThickness="1.5">
                    <Image Source="avares://CamScope.App/Assets/images/shatrughna.jpg" Stretch="UniformToFill"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Shatrughna Ambhore" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Lead Creator &amp; Engineer ↗" FontSize="9" Foreground="{StaticResource CyanAccent}"/>
                  </StackPanel>
                </Grid>
              </Button>

              <StackPanel Spacing="2">
                <TextBlock Text="CamScope Desktop v1.0" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Text=".NET 10 LTS • Avalonia 11" FontSize="9" Foreground="{StaticResource TextMuted}"/>
              </StackPanel>
            </StackPanel>
          </Border>

        </Grid>
      </Border>

      <!-- Active Content View -->
      <Border Grid.Column="1" Background="{StaticResource AppBackground}" Padding="20">
        <ContentControl Content="{Binding CurrentPage}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
              <views:OverviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiscoveryViewModel}">
              <views:DiscoveryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
              <views:InventoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LiveMonitoringViewModel}">
              <views:LiveMonitoringView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecordingsViewModel}">
              <views:RecordingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkExplorerViewModel}">
              <views:NetworkExplorerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WifiSecurityViewModel}">
              <views:WifiSecurityView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DeviceGroupsViewModel}">
              <views:DeviceGroupsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
              <views:DiagnosticsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
              <views:AuditLogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
              <views:SettingsView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>

    </Grid>

    <!-- Created By Profile Modal Overlay -->
    <Border Grid.Row="0" Grid.RowSpan="3"
            Background="#D0020617"
            IsVisible="{Binding IsProfileModalOpen}"
            ZIndex="1000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Border Width="420"
              Background="#0F172A"
              BorderBrush="#1E293B"
              BorderThickness="1"
              CornerRadius="16"
              Padding="24,20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto">

          <!-- Close Button (Top Right) -->
          <Button Grid.Row="0" Content="✕"
                  Command="{Binding CloseProfileModalCommand}"
                  HorizontalAlignment="Right"
                  Background="#1E293B"
                  Foreground="#94A3B8"
                  CornerRadius="8"
                  Padding="8,4"
                  FontSize="12"
                  Cursor="Hand"/>

          <!-- Centered Profile Image with Gradient Ring -->
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,-10,0,10">
            <!-- Gradient Outer Ring -->
            <Border Width="148" Height="148" CornerRadius="74" Padding="4">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="#2563EB" Offset="0.0"/>
                  <GradientStop Color="#6366F1" Offset="0.5"/>
                  <GradientStop Color="#9333EA" Offset="1.0"/>
                </LinearGradientBrush>
              </Border.Background>
              <!-- Inner Border Ring -->
              <Border CornerRadius="70" ClipToBounds="True" Background="#0F172A" BorderBrush="#0F172A" BorderThickness="4">
                <Image Source="avares://CamScope.App/Assets/images/shatrughna.jpg" Stretch="UniformToFill"/>
              </Border>
            </Border>

            <!-- Full View Button -->
            <Button Command="{Binding OpenPhotoCommand}"
                    Background="#0F172A"
                    BorderBrush="#3B82F6"
                    BorderThickness="1"
                    Foreground="#93C5FD"
                    CornerRadius="12"
                    Padding="10,3"
                    FontSize="10"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Margin="0,-14,0,0"
                    Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="🔍" FontSize="10"/>
                <TextBlock Text="Full View" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Name -->
          <TextBlock Grid.Row="2"
                     Text="Shatrughna Ambhore"
                     FontSize="20"
                     FontWeight="ExtraBold"
                     Foreground="White"
                     HorizontalAlignment="Center"
                     Margin="0,4,0,2"/>

          <!-- Title Pill Badge -->
          <Border Grid.Row="3"
                  Background="#1A3B82F6"
                  BorderBrush="#4D3B82F6"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="12,3"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,10">
            <TextBlock Text="Lead Creator &amp; Software Engineer"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#93C5FD"/>
          </Border>

          <!-- Bio Description -->
          <TextBlock Grid.Row="4"
                     Text="Architected LearningOS to deliver a resilient, career-grade 100-day engineering and AI learning system."
                     FontSize="12"
                     Foreground="#CBD5E1"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     LineHeight="18"
                     MaxWidth="360"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,16"/>

          <!-- Contact Buttons List -->
          <StackPanel Grid.Row="5" Spacing="8" Margin="0,0,0,16">
            <!-- Email -->
            <Button Command="{Binding OpenEmailCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,9"
                    Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="✉️" FontSize="12"/>
                <TextBlock Text="ambhoreshatrughna@gmail.com" FontSize="11" FontWeight="Medium" Foreground="#93C5FD"/>
              </StackPanel>
            </Button>

            <!-- Phone -->
            <Button Command="{Binding OpenPhoneCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,9"
                    Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="📞" FontSize="12"/>
                <TextBlock Text="+91 9604466334" FontSize="11" FontWeight="Medium" Foreground="#6EE7B7"/>
              </StackPanel>
            </Button>

            <!-- GitHub -->
            <Button Command="{Binding OpenGitHubCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,9"
                    Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="🐙" FontSize="12"/>
                <TextBlock Text="GitHub Repository" FontSize="11" FontWeight="Medium" Foreground="#C084FC"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Modal Bottom Action Bar -->
          <Grid Grid.Row="6" ColumnDefinitions="*, Auto" Margin="0,4,0,0">
            <Button Grid.Column="0"
                    Command="{Binding OpenPhotoCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0,4"
                    FontSize="11"
                    HorizontalAlignment="Left"
                    Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="🖼️"/>
                <TextBlock Text="Open full photo ↗" Foreground="#94A3B8"/>
              </StackPanel>
            </Button>

            <Button Grid.Column="1"
                    Content="Close"
                    Command="{Binding CloseProfileModalCommand}"
                    Background="#1E293B"
                    Foreground="#E2E8F0"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,6"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Cursor="Hand"/>
          </Grid>

        </Grid>
      </Border>
    </Border>

  </Grid>

</Window>
