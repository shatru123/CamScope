<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);NU1900;NU1901;NU1902;NU1903;NU1904</NoWarn>
    <UseSharedCompilation>false</UseSharedCompilation>
    <Authors>CamScope Team</Authors>
    <Company>CamScope</Company>
    <Product>CamScope Surveillance &amp; Discovery Platform</Product>
  </PropertyGroup>
</Project>
