<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CamScope.App.ViewModels"
             x:Class="CamScope.App.Views.NetworkExplorerView"
             x:DataType="vm:NetworkExplorerViewModel">

  <Grid>
    <!-- Main Content -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16" Margin="0,0,0,24">

        <!-- Page Header -->
        <Grid ColumnDefinitions="*, Auto">
          <StackPanel Grid.Column="0">
            <TextBlock Text="Network Explorer" Classes="pageHeader"/>
            <TextBlock Text="App-scoped interface binding, macOS network telemetry, Wi-Fi environment, and directed subnet scanning" Classes="pageSubHeader"/>
          </StackPanel>
          <Button Grid.Column="1" Content="Refresh Network Telemetry"
                  Command="{Binding RefreshInventoryCommand}"
                  Classes="secondary" VerticalAlignment="Top"/>
        </Grid>

        <!-- Primary Connection Protection Banner (Green Card) -->
        <Border Classes="card" Background="#0D1F17" BorderBrush="{StaticResource GreenSuccess}" BorderThickness="1">
          <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, *">
            <Border Grid.Row="0" Grid.Column="0" Classes="badgeSuccess" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="✓ INTERNET CONNECTION PROTECTED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenSuccess}"/>
            </Border>
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="CamScope binds camera discovery strictly at application scope. Your Mac's default gateway, DNS, and primary internet connectivity remain unmodified."
                       FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>

            <!-- Route Telemetry Grid -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*, *, *, *" Margin="0,14,0,0">
              <Border Grid.Column="0" Margin="0,0,8,0" Background="#14261D" Padding="10" CornerRadius="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="PRIMARY ADAPTER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock Text="{Binding PrimaryInternetText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Margin="4,0,4,0" Background="#14261D" Padding="10" CornerRadius="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="DEFAULT GATEWAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock Text="{Binding DefaultGatewayText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Margin="4,0,4,0" Background="#14261D" Padding="10" CornerRadius="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="SYSTEM DNS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock Text="{Binding DnsServersText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Border>

              <Border Grid.Column="3" Margin="8,0,0,0" Background="#14261D" Padding="10" CornerRadius="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="CURRENT WI-FI SSID" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                  <TextBlock Text="{Binding CurrentWifiText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CyanAccent}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Routing Invariant Verification Status -->
            <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="10,8" CornerRadius="6"
                    Background="#14261D" BorderBrush="#1C402E" BorderThickness="1">
              <Grid ColumnDefinitions="Auto, *">
                <Border Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                        Classes="badgeSuccess" IsVisible="{Binding IsRoutingStable}">
                  <TextBlock Text="ROUTING INVARIANT CONFIRMED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GreenSuccess}"/>
                </Border>
                <Border Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                        Classes="badgeWarning" IsVisible="{Binding !IsRoutingStable}">
                  <TextBlock Text="ROUTING MUTATION DETECTED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AmberWarning}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding RoutingStabilityText}"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>

            <!-- Dedicated CCTV Route Status Banner -->
            <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="10,8" CornerRadius="6"
                    Background="#0D1E30" BorderBrush="{StaticResource CyanAccent}" BorderThickness="1">
              <Grid ColumnDefinitions="Auto, *">
                <Border Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                        Classes="badgeCyan" IsVisible="{Binding HasCctvConnection}">
                  <TextBlock Text="CCTV DEDICATED ROUTE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
                </Border>
                <Border Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                        Classes="badgeMuted" IsVisible="{Binding !HasCctvConnection}">
                  <TextBlock Text="CCTV APP-SCOPED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding CctvStatusText}"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- Active Scanning Binding & Diagnostics -->
        <Border Classes="card" Background="#0C1A2E" BorderBrush="{StaticResource CyanAccent}" BorderThickness="1">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
              <Border Grid.Column="0" Classes="badgeCyan" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="ACTIVE DISCOVERY BINDING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
              </Border>
              <TextBlock Grid.Column="1"
                         Text="{Binding SelectedScanningInterface.DisplayText, FallbackValue='No interface selected'}"
                         FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
              <Border Grid.Column="2" Classes="badgeSuccess" VerticalAlignment="Center" Margin="0,0,6,0"
                      IsVisible="{Binding IsStrictBindingActive}">
                <TextBlock Text="✓ Strict Egress Pinning" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GreenSuccess}"/>
              </Border>
              <Border Grid.Column="2" Classes="badgeWarning" VerticalAlignment="Center" Margin="0,0,6,0"
                      IsVisible="{Binding !IsStrictBindingActive}">
                <TextBlock Text="⚠ Unpinned Routing Fallback" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AmberWarning}"/>
              </Border>
              <Border Grid.Column="3" Classes="badgeViolet" VerticalAlignment="Center"
                      IsVisible="{Binding SelectedScanningInterface.IsPrimaryInternet}">
                <TextBlock Text="System Default Route" FontSize="10" FontWeight="Bold" Foreground="{StaticResource VioletAccent}"/>
              </Border>
            </Grid>

            <!-- Binding Status Detail Text -->
            <TextBlock Text="{Binding BindingStatusText}" FontSize="11" Foreground="{StaticResource CyanAccent}"/>

            <!-- Diagnostic Explanations -->
            <Border Background="#10233B" Padding="10" CornerRadius="6" Margin="0,2,0,0">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Reachability.SummaryExplanation}"
                           FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>

                <ItemsControl ItemsSource="{Binding Reachability.SuggestedActions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="11" Foreground="{StaticResource AmberWarning}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Physical Adapter Topology & Multi-Adapter Guidance Card -->
        <Border Classes="card" Background="#141B2D" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1">
          <Grid ColumnDefinitions="Auto, *">
            <Border Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Classes="badgeCyan">
              <TextBlock Text="ADAPTER TOPOLOGY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding AdapterTopologyExplanation}"
                       FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <!-- Network Adapters Section -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel Grid.Column="0">
                <TextBlock Text="Network Adapters &amp; Interfaces" Classes="cardTitle"/>
                <TextBlock Text="Select an adapter to bind CamScope discovery and streaming. Non-primary adapters allow isolated camera discovery." FontSize="11" Foreground="{StaticResource TextMuted}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Interfaces.Count, StringFormat='{}{0} Adapters'}"
                         FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>

            <DataGrid ItemsSource="{Binding Interfaces}"
                      SelectedItem="{Binding SelectedScanningInterface}"
                      AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                      Background="Transparent" MaxHeight="240">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Hardware Port" Binding="{Binding HardwarePort}" Width="1.6*"/>
                <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="0.9*"/>
                <DataGridTextColumn Header="IPv4 Address" Binding="{Binding IPv4Address}" Width="1.4*"/>
                <DataGridTextColumn Header="Subnet Mask" Binding="{Binding SubnetMask}" Width="1.3*"/>
                <DataGridTextColumn Header="Gateway" Binding="{Binding GatewayAddress}" Width="1.3*"/>
                <DataGridCheckBoxColumn Header="Multicast" Binding="{Binding SupportsMulticast}" Width="0.9*"/>
                <DataGridCheckBoxColumn Header="Primary" Binding="{Binding IsPrimaryInternet}" Width="0.8*"/>
                <DataGridTemplateColumn Header="Actions" Width="2.2*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <Button Content="Select Scanning"
                                Command="{Binding $parent[UserControl].DataContext.SelectInterfaceCommand}"
                                CommandParameter="{Binding}"
                                Classes="secondary" FontSize="11" Padding="8,4" Margin="2"/>
                        <Button Content="Set CCTV"
                                Command="{Binding $parent[UserControl].DataContext.SetAsCctvInterfaceCommand}"
                                CommandParameter="{Binding}"
                                Classes="secondary" FontSize="11" Padding="8,4" Margin="2"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>

        <!-- Lower Split: Wi-Fi Environment & Subnet Directed Scanner -->
        <Grid ColumnDefinitions="1.1*, 1.4*">

          <!-- Left Column: Detected Wi-Fi Networks -->
          <Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Wi-Fi Network Manager" Classes="cardTitle"/>
                  <TextBlock Text="Scan nearby networks, filter and connect dedicated secondary adapters for CCTV discovery without disrupting primary internet." FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding FilteredWifiNetworks.Count, StringFormat='{}{0} Available'}"
                           FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
              </Grid>

              <TextBlock Text="{Binding PermissionExplanation}"
                         IsVisible="{Binding !IsWifiPermitted}"
                         FontSize="11" Foreground="{StaticResource AmberWarning}" TextWrapping="Wrap"/>

              <!-- Search Bar -->
              <TextBox Text="{Binding WifiSearchQuery}"
                       Watermark="Search Wi-Fi SSID or BSSID..."
                       CornerRadius="6" VerticalContentAlignment="Center"/>

              <!-- Filter and Sort Controls -->
              <Grid ColumnDefinitions="*, *, *">
                <StackPanel Grid.Column="0" Margin="0,0,4,0" Spacing="2">
                  <TextBlock Text="SECURITY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                  <ComboBox ItemsSource="{Binding SecurityFilterOptions}"
                            SelectedItem="{Binding SelectedSecurityFilter}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="2,0,2,0" Spacing="2">
                  <TextBlock Text="BAND" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                  <ComboBox ItemsSource="{Binding BandFilterOptions}"
                            SelectedItem="{Binding SelectedBandFilter}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="4,0,0,0" Spacing="2">
                  <TextBlock Text="SORT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                  <ComboBox ItemsSource="{Binding SortOptions}"
                            SelectedItem="{Binding SelectedSortOption}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Grid>

              <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredWifiNetworks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <Border Background="#161E2E" BorderBrush="{StaticResource SubtleBorder}"
                              BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*, Auto">
                          <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Ssid}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                              <Border Classes="badgeSuccess" IsVisible="{Binding IsCurrent}">
                                <TextBlock Text="Primary Internet" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GreenSuccess}"/>
                              </Border>
                              <Border Classes="badgeViolet">
                                <TextBlock Text="{Binding BandGroup}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource VioletAccent}"/>
                              </Border>
                              <Border Classes="badgeCyan" IsVisible="{Binding !IsSecured}">
                                <TextBlock Text="Open" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
                              </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                              <TextBlock Text="{Binding SignalText, StringFormat='Signal: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                              <TextBlock Text="{Binding Channel, StringFormat='Ch: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                              <TextBlock Text="{Binding Security, StringFormat='Sec: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                          </StackPanel>

                          <Button Grid.Column="1" Content="Connect..."
                                  Command="{Binding $parent[UserControl].DataContext.OpenConnectModalCommand}"
                                  CommandParameter="{Binding}"
                                  Classes="primary" FontSize="11" Padding="10,5" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>

          <!-- Right Column: Directed Subnet Scanner -->
          <Border Grid.Column="1" Classes="card" Margin="8,0,0,0">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Directed Subnet Scanner" Classes="cardTitle"/>
                  <TextBlock Text="Sweep IP ranges on the selected adapter via directed unicast UDP probes (max 512 hosts)." FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
                <Border Classes="badgeCyan" Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedScanningInterface.Name, FallbackValue='No Adapter'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
                </Border>
              </Grid>

              <!-- Controls -->
              <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4,0,0">
                <TextBox Grid.Column="0" Text="{Binding SubnetInput}"
                         Watermark="e.g. 192.168.1.0/24"
                         CornerRadius="6" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Sweep Subnet"
                        Command="{Binding StartSubnetScanCommand}"
                        IsEnabled="{Binding !IsScanningSubnet}"
                        Classes="primary" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Cancel"
                        Command="{Binding CancelSubnetScanCommand}"
                        IsEnabled="{Binding IsScanningSubnet}"
                        Classes="danger"/>
              </Grid>

              <!-- Progress & Status -->
              <StackPanel Spacing="4" Margin="0,4,0,0">
                <ProgressBar Value="{Binding SubnetProgressPercentage}" Maximum="100" Height="6" CornerRadius="3"
                             Foreground="{StaticResource CyanAccent}"/>
                <Grid ColumnDefinitions="*, Auto">
                  <TextBlock Grid.Column="0" Text="{Binding SubnetStatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                  <TextBlock Grid.Column="1" Text="{Binding SubnetDiscoveredCount, StringFormat='{}{0} Camera(s) Found'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GreenSuccess}"/>
                </Grid>
              </StackPanel>

              <TextBlock Text="{Binding SubnetErrorMessage}" FontSize="11" Foreground="{StaticResource RedDanger}"
                         IsVisible="{Binding SubnetErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         TextWrapping="Wrap"/>

              <!-- Discovered Devices from Subnet Sweep -->
              <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SubnetDiscoveredDevices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#161E2E" BorderBrush="{StaticResource SubtleBorder}"
                              BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="*, Auto">
                          <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding Host, StringFormat='IP: {0}'}" FontSize="11" Foreground="{StaticResource CyanAccent}"/>
                            <TextBlock Text="{Binding Vendor, StringFormat='Vendor: {0}'}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                          </StackPanel>
                          <Border Grid.Column="1" Classes="badgeSuccess" VerticalAlignment="Center">
                            <TextBlock Text="ONVIF Ready" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GreenSuccess}"/>
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>

        </Grid>

      </StackPanel>
    </ScrollViewer>

    <!-- In-App Wi-Fi Connection Dialog -->
    <Border Background="#D0000000" IsVisible="{Binding IsConnectModalOpen}">
      <Border Classes="card" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource BorderColor}"
              BorderThickness="1" CornerRadius="12" Padding="24">
        <StackPanel Spacing="16">

          <!-- Modal Header with Explicit State Badge -->
          <Grid ColumnDefinitions="*, Auto, Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="Connect to Wi-Fi Network" FontSize="16" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
              <Border CornerRadius="4" Padding="6,2" Background="{Binding ConnectionStateBadgeColor}" VerticalAlignment="Center">
                <TextBlock Text="{Binding ConnectionStateBadgeText}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
              </Border>
            </StackPanel>
            <Button Grid.Column="2" Content="✕" Command="{Binding CloseConnectModalCommand}"
                    Classes="secondary" FontSize="12" Padding="6,2" VerticalAlignment="Center"/>
          </Grid>

          <!-- Target Network Summary Card -->
          <Border Background="#101C2E" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1"
                  CornerRadius="8" Padding="12">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{Binding TargetWifi.Ssid}" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <Border Grid.Column="1" Classes="badgeSuccess" IsVisible="{Binding TargetWifi.IsCurrent}">
                  <TextBlock Text="Currently Connected" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GreenSuccess}"/>
                </Border>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="badgeViolet">
                  <TextBlock Text="{Binding TargetWifi.BandGroup, FallbackValue='Wi-Fi'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource VioletAccent}"/>
                </Border>
                <Border Classes="badgeMuted">
                  <TextBlock Text="{Binding TargetWifi.Security, FallbackValue='WPA2'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                </Border>
                <TextBlock Text="{Binding TargetWifi.SignalText, FallbackValue='Signal: Unknown'}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Enterprise 802.1X Warning Card -->
          <Border Background="#1E1738" BorderBrush="{StaticResource VioletAccent}" BorderThickness="1"
                  CornerRadius="8" Padding="12" IsVisible="{Binding IsUnsupportedAuthMode}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto, *">
                <TextBlock Grid.Column="0" Text="🔒 " FontSize="14" Foreground="{StaticResource VioletAccent}" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="802.1X Enterprise Authentication Detected" FontSize="12" FontWeight="Bold" Foreground="{StaticResource VioletAccent}"/>
              </Grid>
              <TextBlock Text="This network uses 802.1X Enterprise (EAP/RADIUS) authentication with certificates or enterprise credentials. macOS requires these to be configured via System Settings or a Configuration Profile. Direct in-app password entry is not supported for 802.1X."
                         FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="16"/>
              <Button Content="Open macOS Wi-Fi Settings..." Command="{Binding OpenSystemSettingsCommand}"
                      Classes="primary" HorizontalAlignment="Left" Padding="12,6"/>
            </StackPanel>
          </Border>

          <!-- Target Interface Selector -->
          <StackPanel Spacing="4">
            <TextBlock Text="Target Network Adapter" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
            <ComboBox ItemsSource="{Binding AvailableWifiInterfaces}"
                      SelectedItem="{Binding TargetInterfaceForConnect}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="{Binding HardwarePort, StringFormat='({0})'}" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding IPv4Address}" Foreground="{StaticResource CyanAccent}"/>
                    <Border Classes="badgeSuccess" IsVisible="{Binding IsPrimaryInternet}">
                      <TextBlock Text="Primary Internet" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GreenSuccess}"/>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <!-- Single Adapter Concurrency Warning (When target is primary or only 1 adapter) -->
          <Border Background="#261E0F" BorderBrush="{StaticResource AmberWarning}" BorderThickness="1"
                  CornerRadius="8" Padding="12" IsVisible="{Binding RequiresSingleAdapterWarning}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto, *">
                <TextBlock Grid.Column="0" Text="⚠ " FontSize="14" Foreground="{StaticResource AmberWarning}" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="Single Adapter Concurrency Notice" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AmberWarning}"/>
              </Grid>
              <TextBlock Text="Your Mac is currently using this Wi-Fi adapter for its primary internet connection. Single physical Wi-Fi hardware cannot connect to two SSIDs simultaneously. Connecting will alter your system-wide internet route.&#x0a;&#x0a;To discover CCTV cameras on an isolated Wi-Fi network without disrupting your primary internet, attach a secondary physical adapter (such as a USB-C Ethernet or Wi-Fi adapter) and select it above."
                         FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="16"/>
              <CheckBox IsChecked="{Binding UserConfirmedSingleAdapterSwitch}"
                        Content="I acknowledge and authorize switching the primary Wi-Fi connection"
                        FontSize="11" Foreground="{StaticResource AmberWarning}"/>
            </StackPanel>
          </Border>

          <!-- Dedicated Secondary Adapter Isolation Banner -->
          <Border Background="#0E2319" BorderBrush="{StaticResource GreenSuccess}" BorderThickness="1"
                  CornerRadius="8" Padding="12" IsVisible="{Binding !RequiresSingleAdapterWarning}">
            <StackPanel Spacing="4">
              <TextBlock Text="✓ Dedicated Secondary Adapter Isolation Confirmed" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GreenSuccess}"/>
              <TextBlock Text="This connection will be established on your secondary physical adapter. Your Mac's default gateway, DNS, and primary internet connectivity will remain unmodified and protected."
                         FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Password Field (Visible for secured networks) -->
          <StackPanel Spacing="4" IsVisible="{Binding TargetWifi.IsSecured, FallbackValue=True}">
            <TextBlock Text="Wi-Fi Password" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
            <Grid ColumnDefinitions="*, Auto">
              <TextBox Grid.Column="0" Text="{Binding WifiPasswordInput}"
                       PasswordChar="{Binding PasswordMaskChar}"
                       Watermark="Enter WPA/WPA2/WPA3 password"
                       CornerRadius="6,0,0,6" VerticalContentAlignment="Center"/>
              <Button Grid.Column="1" Content="{Binding PasswordToggleText}"
                      Command="{Binding TogglePasswordVisibilityCommand}"
                      Classes="secondary" CornerRadius="0,6,6,0" Padding="12,6"/>
            </Grid>
            <TextBlock Text="{Binding PasswordValidationError}" FontSize="11" Foreground="{StaticResource RedDanger}"
                       IsVisible="{Binding PasswordValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>

          <!-- Secure Keychain Opt-in Checkbox -->
          <CheckBox IsChecked="{Binding RememberCredentialsInStore}"
                    IsVisible="{Binding TargetWifi.IsSecured, FallbackValue=True}"
                    Content="Remember credentials in macOS Keychain"
                    FontSize="11" Foreground="{StaticResource TextSecondary}"/>

          <!-- Open Network Notice -->
          <Border Background="#10233B" Padding="10" CornerRadius="6"
                  IsVisible="{Binding !TargetWifi.IsSecured, FallbackValue=False}">
            <TextBlock Text="This network is open (no encryption). No password is required to connect."
                       FontSize="11" Foreground="{StaticResource CyanAccent}"/>
          </Border>

          <!-- Authentication Failure Card -->
          <Border Background="#2E1114" BorderBrush="{StaticResource RedDanger}" BorderThickness="1"
                  CornerRadius="8" Padding="12" IsVisible="{Binding IsAuthFailed}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto, *">
                <TextBlock Grid.Column="0" Text="❌ " FontSize="14" Foreground="{StaticResource RedDanger}" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="Authentication Failed" FontSize="12" FontWeight="Bold" Foreground="{StaticResource RedDanger}"/>
              </Grid>
              <TextBlock Text="Authentication failed. Check the password and try again."
                         FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
              <TextBlock Text="{Binding ErrorClassification}"
                         FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                         IsVisible="{Binding ErrorClassification, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <TextBlock Text="CamScope adheres to strict security standards: it never brute-forces or bypasses encryption. Edit the password above and click Retry Connection, or explore authorized alternatives below."
                         FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Progress / Error / Success Messages -->
          <StackPanel Spacing="6" Margin="0,4,0,0">
            <!-- Connecting State -->
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConnectingWifi}">
              <ProgressBar IsIndeterminate="True" Width="80" Height="4" Foreground="{StaticResource CyanAccent}"/>
              <TextBlock Text="{Binding ConnectStatusMessage}" FontSize="11" Foreground="{StaticResource CyanAccent}"/>
            </StackPanel>

            <!-- Error Banner (When not in auth failed card) -->
            <Border Background="#2B1214" BorderBrush="{StaticResource RedDanger}" BorderThickness="1"
                    CornerRadius="6" Padding="10"
                    IsVisible="{Binding ConnectErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding ConnectErrorMessage}" FontSize="11" Foreground="{StaticResource RedDanger}" TextWrapping="Wrap"/>
            </Border>

            <!-- Success Banner -->
            <Border Background="#0E2319" BorderBrush="{StaticResource GreenSuccess}" BorderThickness="1"
                    CornerRadius="6" Padding="10"
                    IsVisible="{Binding ConnectSuccess}">
              <TextBlock Text="{Binding ConnectSuccessMessage}" FontSize="11" Foreground="{StaticResource GreenSuccess}" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>

          <!-- Expandable Authorized Alternatives Accordion -->
          <Border Background="#101826" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1"
                  CornerRadius="8" Padding="10">
            <StackPanel Spacing="8">
              <Button Command="{Binding ToggleAuthorizedAlternativesCommand}"
                      Classes="secondary" HorizontalAlignment="Stretch" Padding="8,6">
                <Grid ColumnDefinitions="*, Auto">
                  <TextBlock Grid.Column="0" Text="Don't know the password? View Authorized Alternatives"
                             FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CyanAccent}"/>
                  <TextBlock Grid.Column="1" Text="▾" FontSize="12" Foreground="{StaticResource CyanAccent}"/>
                </Grid>
              </Button>

              <StackPanel Spacing="10" IsVisible="{Binding ShowAuthorizedAlternatives}" Margin="0,4,0,0">
                <!-- Option 1: Switch to Wired Ethernet -->
                <Border Background="#142132" CornerRadius="6" Padding="10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Option 1: Switch to Authorized Wired Ethernet (Recommended)"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenSuccess}"/>
                    <TextBlock Text="Wired connections bypass Wi-Fi authentication entirely and offer zero-jitter camera streaming."
                               FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>

                    <ItemsControl ItemsSource="{Binding AvailableWiredInterfaces}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                              <TextBlock Text="{Binding HardwarePort, StringFormat='({0})'}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                              <TextBlock Text="{Binding IPv4Address}" Foreground="{StaticResource CyanAccent}" FontSize="11"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Use for CCTV"
                                    Command="{Binding $parent[UserControl].((vm:NetworkExplorerViewModel)DataContext).SelectWiredAlternativeCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="secondary" FontSize="10" Padding="8,2"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No active wired adapters detected. Connect a USB-C Ethernet adapter for direct camera access."
                               FontSize="10" Foreground="{StaticResource TextMuted}"
                               IsVisible="{Binding !AvailableWiredInterfaces.Count}"/>
                  </StackPanel>
                </Border>

                <!-- Option 2: Request Admin Access -->
                <Border Background="#142132" CornerRadius="6" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Option 2: Network Administrator Access Request"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="If this is an enterprise or facility CCTV network, contact your network administrator to obtain the WPA passphrase, access credentials, or request device MAC address whitelisting."
                               FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Option 3: Dedicated CCTV VLAN -->
                <Border Background="#142132" CornerRadius="6" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Option 3: Dedicated CCTV VLAN / Guest Network"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
                    <TextBlock Text="Cameras may be partitioned on an isolated security VLAN or secondary SSID. Verify with site operations whether cameras are hosted on a separate IoT network."
                               FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Option 4: Hardware Router Reset & Configuration Guide -->
                <Border Background="#142132" CornerRadius="6" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Option 4: Router Administration &amp; Hardware Reset"
                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource AmberWarning}"/>
                    <TextBlock Text="If you are the authorized owner of the camera access point: access the router admin portal (typically http://192.168.1.1) to view or reset the WPA key, or consult the manufacturer guide to perform a physical hardware reset to restore documented factory defaults."
                               FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <!-- Security Policy Banner -->
                <Border Background="#1B1424" BorderBrush="{StaticResource VioletAccent}" BorderThickness="1" CornerRadius="6" Padding="8">
                  <TextBlock Text="Security Guarantee: CamScope never attempts to crack passwords, bypass encryption, or exploit router vulnerabilities."
                             FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Modal Action Buttons -->
          <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,8,0,0">
            <Button Grid.Column="0" Content="macOS Settings..." Command="{Binding OpenSystemSettingsCommand}"
                    Classes="secondary" FontSize="11" Padding="8,4"/>
            <Button Grid.Column="2" Content="Cancel" Command="{Binding CloseConnectModalCommand}"
                    Classes="secondary" Margin="0,0,8,0"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
              <!-- In-flight Cancel Button -->
              <Button Content="Stop Connecting" Command="{Binding CancelConnectWifiCommand}"
                      Classes="danger" IsVisible="{Binding IsConnectingWifi}"/>

              <!-- Retry Button (Shown on retryable failure) -->
              <Button Content="Retry Connection" Command="{Binding RetryConnectWifiCommand}"
                      Classes="primary" IsVisible="{Binding CanRetry}" IsEnabled="{Binding !IsConnectingWifi}"/>

              <!-- Standard Connect Button (Shown when not in retry state and not connecting) -->
              <Button Content="Connect" Command="{Binding ConnectWifiAsyncCommand}"
                      Classes="primary" IsVisible="{Binding !CanRetry}" IsEnabled="{Binding !IsConnectingWifi}"/>
            </StackPanel>
          </Grid>

        </StackPanel>
      </Border>
    </Border>

  </Grid>

</UserControl>
