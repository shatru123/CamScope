<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CamScope.App.ViewModels"
             x:Class="CamScope.App.Views.NetworkInterfacesView"
             x:DataType="vm:NetworkInterfacesViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20">

      <Grid ColumnDefinitions="*, Auto">
        <StackPanel Grid.Column="0">
          <TextBlock Text="Network Interfaces" Classes="pageHeader"/>
          <TextBlock Text="Local network adapters, active IPv4 subnets, and multicast capabilities" Classes="pageSubHeader"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh Adapters" Command="{Binding RefreshCommand}"
                Classes="secondary" VerticalAlignment="Top"/>
      </Grid>

      <Border Classes="card">
        <DataGrid ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}"
                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                  Background="Transparent">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Interface Name" Binding="{Binding Name}" Width="1.5*"/>
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
            <DataGridTextColumn Header="IPv4 Address" Binding="{Binding IPv4Address}" Width="1.5*"/>
            <DataGridTextColumn Header="Subnet Mask" Binding="{Binding SubnetMask}" Width="1.5*"/>
            <DataGridCheckBoxColumn Header="Multicast Ready" Binding="{Binding SupportsMulticast}" Width="1.2*"/>
            <DataGridCheckBoxColumn Header="Link Up" Binding="{Binding IsUp}" Width="1*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
